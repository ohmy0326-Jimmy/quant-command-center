{
  "schema_version": "1.5.0",
  "header": "X-API-Key",
  "models": {
    "health": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "examples": [
            "1.5.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "as_of": {
          "description": "Asia/Taipei，ISO 8601，含時區偏移。",
          "title": "As Of",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "as_of",
        "status"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "portfolio": {
      "$defs": {
        "BetaLeverageLegResponse": {
          "additionalProperties": false,
          "properties": {
            "notional_exposure": {
              "description": "名目曝險，台幣。現股／ETF＝市值 × 槓桿；期貨＝報價 × 乘數 × 口數；選擇權＝|Delta 名目|。",
              "title": "Notional Exposure",
              "type": "number"
            },
            "beta_exposure": {
              "description": "Beta 曝險＝Σ(名目曝險 × Beta)，台幣。",
              "title": "Beta Exposure",
              "type": "number"
            },
            "nav": {
              "description": "淨值，台幣。",
              "title": "Nav",
              "type": "number"
            },
            "leverage": {
              "description": "槓桿＝名目曝險 ÷ 淨值。",
              "title": "Leverage",
              "type": "number"
            },
            "avg_beta": {
              "description": "部位平均 Beta＝Beta 曝險 ÷ 名目曝險。",
              "title": "Avg Beta",
              "type": "number"
            },
            "account_beta": {
              "description": "帳戶 Beta＝Beta 曝險 ÷ 淨值＝leverage × avg_beta。",
              "title": "Account Beta",
              "type": "number"
            }
          },
          "required": [
            "notional_exposure",
            "beta_exposure",
            "nav",
            "leverage",
            "avg_beta",
            "account_beta"
          ],
          "title": "BetaLeverageLegResponse",
          "type": "object"
        },
        "BetaLeverageResponse": {
          "additionalProperties": false,
          "properties": {
            "tw": {
              "$ref": "#/$defs/BetaLeverageLegResponse",
              "description": "台股（含臺指期、台股選擇權）。"
            },
            "us": {
              "$ref": "#/$defs/BetaLeverageLegResponse",
              "description": "美股。"
            },
            "total": {
              "$ref": "#/$defs/BetaLeverageLegResponse",
              "description": "合計。tw + us 的名目曝險、Beta 曝險、淨值分別相加等於 total。"
            }
          },
          "required": [
            "tw",
            "us",
            "total"
          ],
          "title": "BetaLeverageResponse",
          "type": "object"
        },
        "PositionResponse": {
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "description": "標的代號，對應第四頁「標的」。",
              "title": "Symbol",
              "type": "string"
            },
            "name": {
              "description": "名稱。試算表沒填時為空字串。",
              "title": "Name",
              "type": "string"
            },
            "qty": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "持有數量。",
              "title": "Qty"
            },
            "price": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "即時報價，原幣。臺指期是指數點數，美股是美元。",
              "title": "Price"
            },
            "market_value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "即時市值，台幣。第四頁欄位「即時市值(台幣)」。1.3.0 起期貨為名目市值（報價 × 乘數 × 口數），不再是保證金加未實現損益（舊值見 equity_value）。",
              "title": "Market Value"
            },
            "pnl": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "淨未實現損益，台幣。原幣損益乘上換算匯率。股票損益已含 0.3% 證交稅估算，不再從淨值扣一次。",
              "title": "Pnl"
            },
            "equity_value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。計入帳戶淨值的價值，台幣。現股＝市值；期貨＝保證金＋未實現損益（1.2.0 的 market_value）。",
              "title": "Equity Value"
            },
            "leverage": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。採用的槓桿倍數。現股 1、槓桿 ETF 2 或 3、期貨 1（槓桿已在名目裡）。",
              "title": "Leverage"
            },
            "notional_exposure": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。名目曝險，台幣。現股／ETF＝market_value × leverage；期貨＝名目市值。",
              "title": "Notional Exposure"
            },
            "underlying": {
              "default": "",
              "description": "1.3.0 新增。槓桿 ETF 的標的（例 SOXL→SOXX）。非槓桿為空字串。",
              "title": "Underlying",
              "type": "string"
            },
            "underlying_beta": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。槓桿 ETF 標的一年 Beta（對 S&P 500；台股槓桿 ETF 對加權指數定義 1）。非槓桿為 null。",
              "title": "Underlying Beta"
            },
            "beta": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。套在名目曝險上的 Beta＝beta_exposure ÷ notional_exposure。槓桿 ETF＝標的一年 Beta；現股＝自身一年 Beta；臺指期＝1。",
              "title": "Beta"
            },
            "effective_beta": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。套在市值上的 Beta＝leverage × beta（槓桿 ETF＝槓桿 × 標的 Beta）。",
              "title": "Effective Beta"
            },
            "beta_exposure": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。Beta 曝險，台幣＝notional_exposure × beta＝market_value × effective_beta（現股）。槓桿只乘一次。空單為負。",
              "title": "Beta Exposure"
            },
            "beta_source": {
              "default": "",
              "description": "1.3.0 新增。Beta 來源說明。",
              "title": "Beta Source",
              "type": "string"
            },
            "product": {
              "default": "",
              "description": "1.5.0 新增。可轉債為 cb、可轉債資產交換為 cbas，其餘空字串。",
              "title": "Product",
              "type": "string"
            },
            "delta": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.5.0 新增。可轉債／CBAS 的股權 Delta（轉換股數的比例）。試算表有填就用試算表；可轉債否則用轉換價值／市價或債底估算。沒有資料時為 null。",
              "title": "Delta"
            },
            "delta_source": {
              "default": "",
              "description": "1.5.0 新增。Delta 來源：試算表、估算(轉換價值/市價)、估算(債底)、估算(Black-Scholes)。",
              "title": "Delta Source",
              "type": "string"
            },
            "conversion_value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.5.0 新增。整筆轉換價值，台幣，＝股價 × (面額／轉換價格) × 張數。張數為負時為負。算不出來是 null。",
              "title": "Conversion Value"
            },
            "conversion_value_points": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.5.0 新增。轉換價值的百元報價＝股價／轉換價格 × 100，跟可轉債報價同一單位，不乘張數。",
              "title": "Conversion Value Points"
            },
            "parity_premium_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.5.0 新增。可轉債轉換溢價率（百分點）＝百元報價／轉換價值百元 − 1，再乘 100。CBAS 或資料不足時為 null。",
              "title": "Parity Premium Pct"
            }
          },
          "required": [
            "symbol",
            "name",
            "qty",
            "price",
            "market_value",
            "pnl"
          ],
          "title": "PositionResponse",
          "type": "object"
        },
        "YuantaFuturesResponse": {
          "additionalProperties": false,
          "properties": {
            "equity": {
              "description": "元大期貨權益數，台幣。本日餘額（試算表現金欄，空白時用 168308）加期貨未實現損益（期交所報價）。",
              "title": "Equity",
              "type": "number"
            },
            "cash_ledger": {
              "default": 0.0,
              "description": "元大期貨本日餘額（現金賬）。",
              "title": "Cash Ledger",
              "type": "number"
            },
            "initial_margin": {
              "default": 0.0,
              "description": "原始保證金總額，台幣。",
              "title": "Initial Margin",
              "type": "number"
            },
            "maintenance_margin": {
              "description": "維持保證金合計，台幣。",
              "title": "Maintenance Margin",
              "type": "number"
            },
            "risk_indicator_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "權益比率＝權益數 ÷ 原始保證金 × 100。",
              "title": "Risk Indicator Pct"
            },
            "margin_ratio_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "權益 ÷ 維持保證金 × 100。沒有保證金時為 null。",
              "title": "Margin Ratio Pct"
            },
            "excess_margin": {
              "description": "可動用保證金＝權益數−原始保證金（可為負）。",
              "title": "Excess Margin",
              "type": "number"
            },
            "margin_call_distance": {
              "default": 0.0,
              "description": "距追繳金額＝權益數 − 維持保證金（低於維持保證金時為負）。",
              "title": "Margin Call Distance",
              "type": "number"
            },
            "margin_call_points": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "距追繳點數＝距追繳金額 ÷ 臺指期每點市值總合。無期貨部位時為 null。",
              "title": "Margin Call Points"
            },
            "margin_call": {
              "description": "權益低於維持保證金時為 true。",
              "title": "Margin Call",
              "type": "boolean"
            }
          },
          "required": [
            "equity",
            "maintenance_margin",
            "margin_ratio_pct",
            "excess_margin",
            "margin_call"
          ],
          "title": "YuantaFuturesResponse",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "examples": [
            "1.5.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "as_of": {
          "description": "Asia/Taipei，這次回應產生的時間。",
          "title": "As Of",
          "type": "string"
        },
        "currency": {
          "const": "TWD",
          "description": "淨值、曝險、市值、損益的幣別。",
          "title": "Currency",
          "type": "string"
        },
        "usdtwd": {
          "description": "這次估價用的美元兌台幣，與第四頁同一來源。",
          "title": "Usdtwd",
          "type": "number"
        },
        "usdtwd_source": {
          "default": "live",
          "description": "1.4.0 新增。live＝即時；cached＝本程序最近一次成功值（3 天內）；last_known＝NAV_Snapshots 最後一筆即時匯率；fallback＝預設 32.5（美股市值可能失真）。",
          "enum": [
            "live",
            "cached",
            "last_known",
            "fallback"
          ],
          "title": "Usdtwd Source",
          "type": "string"
        },
        "warnings": {
          "description": "1.4.0 新增。估價警告，例如匯率不是即時值。",
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "net_value": {
          "description": "總帳戶淨值，台幣。第四頁 metrics.nav。",
          "title": "Net Value",
          "type": "number"
        },
        "exposure": {
          "description": "總名目曝險，台幣。第四頁 metrics.exposure。＝beta_leverage.total.notional_exposure。",
          "title": "Exposure",
          "type": "number"
        },
        "leverage": {
          "description": "名目曝險 ÷ 淨值。畫面上四捨五入到小數兩位。＝beta_leverage.total.leverage。",
          "title": "Leverage",
          "type": "number"
        },
        "cash_pct": {
          "description": "現金 ÷ 淨值 × 100，百分點。13.4 表示 13.4%。畫面上四捨五入到小數一位。",
          "title": "Cash Pct",
          "type": "number"
        },
        "beta": {
          "description": "帳戶 Beta（合計）＝(tw_exposure + us_exposure) ÷ 總淨值＝Σ(名目曝險 × Beta) ÷ 淨值。第四頁 metrics.beta。＝beta_leverage.total.account_beta。",
          "title": "Beta",
          "type": "number"
        },
        "tw_beta": {
          "description": "台股帳戶 Beta＝tw_exposure ÷ tw_nav。＝beta_leverage.tw.account_beta。",
          "title": "Tw Beta",
          "type": "number"
        },
        "us_beta": {
          "description": "美股帳戶 Beta＝us_exposure ÷ us_nav。＝beta_leverage.us.account_beta。",
          "title": "Us Beta",
          "type": "number"
        },
        "total_beta": {
          "description": "同 beta。",
          "title": "Total Beta",
          "type": "number"
        },
        "tw_nav": {
          "description": "台股淨值（台股市值 + 元大期貨權益 + 台股現金 - 融資/質押）。",
          "title": "Tw Nav",
          "type": "number"
        },
        "us_nav": {
          "description": "美股淨值（US 市值 + US 現金 - US 借款）。",
          "title": "Us Nav",
          "type": "number"
        },
        "tw_exposure": {
          "description": "舊欄位，保留相容。台股 **Beta 曝險** Σ(名目曝險 × Beta)，台幣；不是名目曝險，所以 tw_exposure + us_exposure ≠ exposure。名目曝險請用 beta_leverage.tw.notional_exposure。",
          "title": "Tw Exposure",
          "type": "number"
        },
        "us_exposure": {
          "description": "舊欄位，保留相容。美股 **Beta 曝險**，台幣；同上。",
          "title": "Us Exposure",
          "type": "number"
        },
        "beta_leverage": {
          "$ref": "#/$defs/BetaLeverageResponse",
          "description": "1.3.0 新增。台股／美股／合計的槓桿、部位平均 Beta、帳戶 Beta。"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/PositionResponse"
          },
          "title": "Positions",
          "type": "array"
        },
        "yuanta_futures": {
          "$ref": "#/$defs/YuantaFuturesResponse"
        }
      },
      "required": [
        "schema_version",
        "as_of",
        "currency",
        "usdtwd",
        "net_value",
        "exposure",
        "leverage",
        "cash_pct",
        "beta",
        "tw_beta",
        "us_beta",
        "total_beta",
        "tw_nav",
        "us_nav",
        "tw_exposure",
        "us_exposure",
        "beta_leverage",
        "positions",
        "yuanta_futures"
      ],
      "title": "PortfolioResponse",
      "type": "object"
    },
    "ai_advice": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "examples": [
            "1.5.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "as_of": {
          "description": "Asia/Taipei，這次回應產生的時間。",
          "title": "As Of",
          "type": "string"
        },
        "text": {
          "description": "AI 避險基金經理人的風控建議，與第四頁按鈕同一套提示詞。",
          "title": "Text",
          "type": "string"
        },
        "model": {
          "description": "Gemini 模型名稱。",
          "title": "Model",
          "type": "string"
        },
        "cached": {
          "description": "true 表示這次沒有重新呼叫模型。",
          "title": "Cached",
          "type": "boolean"
        },
        "generated_at": {
          "description": "Asia/Taipei，這段文字實際產生的時間。",
          "title": "Generated At",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "as_of",
        "text",
        "model",
        "cached",
        "generated_at"
      ],
      "title": "AdviceResponse",
      "type": "object"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "examples": [
            "1.5.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "as_of": {
          "description": "Asia/Taipei。",
          "title": "As Of",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "as_of",
        "detail"
      ],
      "title": "ErrorResponse",
      "type": "object"
    }
  }
}
