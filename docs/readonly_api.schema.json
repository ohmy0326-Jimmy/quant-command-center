{
  "schema_version": "1.9.0",
  "header": "X-API-Key",
  "models": {
    "health": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "examples": [
            "1.9.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "as_of": {
          "description": "Asia/Taipei，ISO 8601，含時區偏移。",
          "title": "As Of",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "as_of",
        "status"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "portfolio": {
      "$defs": {
        "BetaLeverageLegResponse": {
          "additionalProperties": false,
          "properties": {
            "notional_exposure": {
              "description": "名目曝險，台幣。現股／ETF＝市值 × 槓桿；期貨＝報價 × 乘數 × 口數；選擇權＝|Delta 名目|。",
              "title": "Notional Exposure",
              "type": "number"
            },
            "beta_exposure": {
              "description": "Beta 曝險＝Σ(名目曝險 × Beta)，台幣。",
              "title": "Beta Exposure",
              "type": "number"
            },
            "nav": {
              "description": "淨值，台幣。",
              "title": "Nav",
              "type": "number"
            },
            "leverage": {
              "description": "槓桿＝名目曝險 ÷ 淨值。",
              "title": "Leverage",
              "type": "number"
            },
            "avg_beta": {
              "description": "部位平均 Beta＝Beta 曝險 ÷ 名目曝險。",
              "title": "Avg Beta",
              "type": "number"
            },
            "account_beta": {
              "description": "本地基準敏感度＝Beta 曝險 ÷ 這一列使用的淨值。全部 Beta 都估到時等於 leverage × avg_beta。台股對加權、美股對 S&P 500，合計不是單一指數 Beta。",
              "title": "Account Beta",
              "type": "number"
            }
          },
          "required": [
            "notional_exposure",
            "beta_exposure",
            "nav",
            "leverage",
            "avg_beta",
            "account_beta"
          ],
          "title": "BetaLeverageLegResponse",
          "type": "object"
        },
        "BetaLeverageResponse": {
          "additionalProperties": false,
          "properties": {
            "tw": {
              "$ref": "#/$defs/BetaLeverageLegResponse",
              "description": "台股（含臺指期、台股選擇權）。"
            },
            "us": {
              "$ref": "#/$defs/BetaLeverageLegResponse",
              "description": "美股。"
            },
            "total": {
              "$ref": "#/$defs/BetaLeverageLegResponse",
              "description": "合計。tw + us 的名目曝險、Beta 曝險、淨值分別相加等於 total。"
            }
          },
          "required": [
            "tw",
            "us",
            "total"
          ],
          "title": "BetaLeverageResponse",
          "type": "object"
        },
        "CreditRowResponse": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "title": "Id",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "series_id": {
              "default": "",
              "title": "Series Id",
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Value"
            },
            "unit": {
              "default": "",
              "title": "Unit",
              "type": "string"
            },
            "date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Date"
            },
            "change": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Change"
            },
            "change_label": {
              "default": "",
              "title": "Change Label",
              "type": "string"
            },
            "light": {
              "enum": [
                "green",
                "yellow",
                "red",
                "missing",
                "stale",
                "unavailable"
              ],
              "title": "Light",
              "type": "string"
            },
            "light_text": {
              "title": "Light Text",
              "type": "string"
            },
            "reason": {
              "default": "",
              "title": "Reason",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "light",
            "light_text"
          ],
          "title": "CreditRowResponse",
          "type": "object"
        },
        "CreditTransmissionResponse": {
          "additionalProperties": false,
          "description": "1.9.0。與第一頁信用傳導面板同一套 THRESHOLDS，不計入牛熊總分。",
          "properties": {
            "stage": {
              "description": "階段句。只有放款量與信用價格同時惡化才是傳導確認。",
              "title": "Stage",
              "type": "string"
            },
            "stage_code": {
              "enum": [
                "equity_only",
                "price_first",
                "confirmed",
                "volume_only",
                "insufficient"
              ],
              "title": "Stage Code",
              "type": "string"
            },
            "lending_light": {
              "anyOf": [
                {
                  "enum": [
                    "green",
                    "yellow",
                    "red"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "TOTLL 與工商放款 TOTCI（皆為週資料，52 週年增、13 週年化、21 天過舊）的較差燈。要整體綠燈時兩條都得是綠。TOTCI 抓不到才改用 BUSLOANS，該列標明月資料。",
              "title": "Lending Light"
            },
            "price_light": {
              "anyOf": [
                {
                  "enum": [
                    "green",
                    "yellow",
                    "red"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "高收益 OAS、投資級 OAS、NFCI 的較差燈。STLFSI4 有黃或紅時會把價格燈拉差。",
              "title": "Price Light"
            },
            "standards_light": {
              "anyOf": [
                {
                  "enum": [
                    "green",
                    "yellow",
                    "red"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "SLOOS 放款意願。缺失或過舊是 null，不算收緊。",
              "title": "Standards Light"
            },
            "disclaimer": {
              "title": "Disclaimer",
              "type": "string"
            },
            "rule_note": {
              "description": "門檻與快速減速的定義，與畫面上的註解相同。",
              "title": "Rule Note",
              "type": "string"
            },
            "cds": {
              "description": "固定說明沒有免費 CDS，不帶數字。",
              "title": "Cds",
              "type": "string"
            },
            "thresholds": {
              "additionalProperties": true,
              "description": "credit_transmission.THRESHOLDS。燈號只讀這張表。",
              "title": "Thresholds",
              "type": "object"
            },
            "rows": {
              "items": {
                "$ref": "#/$defs/CreditRowResponse"
              },
              "title": "Rows",
              "type": "array"
            }
          },
          "required": [
            "stage",
            "stage_code",
            "lending_light",
            "price_light",
            "standards_light",
            "disclaimer",
            "rule_note",
            "cds",
            "thresholds",
            "rows"
          ],
          "title": "CreditTransmissionResponse",
          "type": "object"
        },
        "PositionResponse": {
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "description": "標的代號，對應第四頁「標的」。",
              "title": "Symbol",
              "type": "string"
            },
            "name": {
              "description": "名稱。試算表沒填時為空字串。",
              "title": "Name",
              "type": "string"
            },
            "qty": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "持有數量。",
              "title": "Qty"
            },
            "price": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "即時報價，原幣。臺指期是指數點數，美股是美元。",
              "title": "Price"
            },
            "market_value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "即時市值，台幣。第四頁欄位「即時市值(台幣)」。1.3.0 起期貨為名目市值（報價 × 乘數 × 口數），不再是保證金加未實現損益（舊值見 equity_value）。",
              "title": "Market Value"
            },
            "pnl": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "淨未實現損益，台幣。原幣損益乘上換算匯率。股票損益已含 0.3% 證交稅估算，不再從淨值扣一次。",
              "title": "Pnl"
            },
            "equity_value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。計入帳戶淨值的價值，台幣。現股＝市值；期貨＝保證金＋未實現損益（1.2.0 的 market_value）。",
              "title": "Equity Value"
            },
            "leverage": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。採用的槓桿倍數。現股 1、槓桿 ETF 2 或 3、期貨 1（槓桿已在名目裡）。",
              "title": "Leverage"
            },
            "notional_exposure": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。名目曝險，台幣。現股／ETF＝market_value × leverage；期貨＝名目市值。1.6.0 起，選擇權或可轉債／CBAS 沒有 Delta 時是 null，不是 0。Delta 為 0 仍是 0。",
              "title": "Notional Exposure"
            },
            "exposure_known": {
              "default": true,
              "description": "1.6.0 新增。false 表示這筆名目曝險未知，notional_exposure 是 null。",
              "title": "Exposure Known",
              "type": "boolean"
            },
            "delta_status": {
              "default": "not_applicable",
              "description": "1.6.0 新增。known 含 Delta 剛好是 0；missing 是沒有 Delta；not_applicable 是現股、ETF、期貨。",
              "enum": [
                "known",
                "missing",
                "not_applicable"
              ],
              "title": "Delta Status",
              "type": "string"
            },
            "underlying": {
              "default": "",
              "description": "1.3.0 新增。槓桿 ETF 的標的（例 SOXL→SOXX）。非槓桿為空字串。",
              "title": "Underlying",
              "type": "string"
            },
            "underlying_beta": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。槓桿 ETF 標的一年 Beta（對 S&P 500；台股槓桿 ETF 對加權指數定義 1）。非槓桿為 null。",
              "title": "Underlying Beta"
            },
            "beta": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。套在名目曝險上的 Beta＝beta_exposure ÷ notional_exposure。槓桿 ETF＝標的一年 Beta；現股＝自身一年 Beta；臺指期＝1。",
              "title": "Beta"
            },
            "effective_beta": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。套在市值上的 Beta＝leverage × beta（槓桿 ETF＝槓桿 × 標的 Beta）。",
              "title": "Effective Beta"
            },
            "beta_exposure": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.3.0 新增。Beta 曝險，台幣＝notional_exposure × beta＝market_value × effective_beta（現股）。槓桿只乘一次。空單為負。",
              "title": "Beta Exposure"
            },
            "beta_source": {
              "default": "",
              "description": "1.3.0 新增。Beta 來源說明。1.8.0 起，資料不足會寫「Beta 未計入」，不會把缺資料顯示成 Beta＝1。",
              "title": "Beta Source",
              "type": "string"
            },
            "beta_quality": {
              "default": "missing",
              "description": "1.8.0 新增。estimated＝這次回歸；fallback＝已標示的預設或手動值；definition＝臺指或加權定義 1；missing＝沒有計入。",
              "enum": [
                "estimated",
                "fallback",
                "definition",
                "missing"
              ],
              "title": "Beta Quality",
              "type": "string"
            },
            "product": {
              "default": "",
              "description": "1.5.0 新增。可轉債為 cb、可轉債資產交換為 cbas，其餘空字串。",
              "title": "Product",
              "type": "string"
            },
            "delta": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.5.0 新增。可轉債／CBAS 的股權 Delta（轉換股數的比例）。試算表有填就用試算表；可轉債否則用轉換價值／市價或債底估算。沒有資料時為 null。",
              "title": "Delta"
            },
            "delta_source": {
              "default": "",
              "description": "1.5.0 新增。Delta 來源：試算表、估算(轉換價值/市價)、估算(債底)、估算(Black-Scholes)。",
              "title": "Delta Source",
              "type": "string"
            },
            "conversion_value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.5.0 新增。整筆轉換價值，台幣，＝股價 × (面額／轉換價格) × 張數。張數為負時為負。算不出來是 null。",
              "title": "Conversion Value"
            },
            "conversion_value_points": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.5.0 新增。轉換價值的百元報價＝股價／轉換價格 × 100，跟可轉債報價同一單位，不乘張數。",
              "title": "Conversion Value Points"
            },
            "parity_premium_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "1.5.0 新增。可轉債轉換溢價率（百分點）＝百元報價／轉換價值百元 − 1，再乘 100。CBAS 或資料不足時為 null。",
              "title": "Parity Premium Pct"
            }
          },
          "required": [
            "symbol",
            "name",
            "qty",
            "price",
            "market_value",
            "pnl"
          ],
          "title": "PositionResponse",
          "type": "object"
        },
        "YuantaFuturesResponse": {
          "additionalProperties": false,
          "properties": {
            "equity": {
              "description": "元大期貨權益數，台幣。本日餘額（試算表現金欄，空白時用 168308）加期貨未實現損益（期交所報價）。",
              "title": "Equity",
              "type": "number"
            },
            "cash_ledger": {
              "default": 0.0,
              "description": "元大期貨本日餘額（現金賬）。",
              "title": "Cash Ledger",
              "type": "number"
            },
            "initial_margin": {
              "default": 0.0,
              "description": "原始保證金總額，台幣。",
              "title": "Initial Margin",
              "type": "number"
            },
            "maintenance_margin": {
              "description": "維持保證金合計，台幣。",
              "title": "Maintenance Margin",
              "type": "number"
            },
            "risk_indicator_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "權益比率＝權益數 ÷ 原始保證金 × 100。",
              "title": "Risk Indicator Pct"
            },
            "margin_ratio_pct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "權益 ÷ 維持保證金 × 100。沒有保證金時為 null。",
              "title": "Margin Ratio Pct"
            },
            "excess_margin": {
              "description": "可動用保證金＝權益數−原始保證金（可為負）。",
              "title": "Excess Margin",
              "type": "number"
            },
            "margin_call_distance": {
              "default": 0.0,
              "description": "距追繳金額＝權益數 − 維持保證金（低於維持保證金時為負）。",
              "title": "Margin Call Distance",
              "type": "number"
            },
            "margin_call_points": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "距追繳點數＝距追繳金額 ÷ 臺指期每點市值總合。無期貨部位時為 null。",
              "title": "Margin Call Points"
            },
            "margin_call": {
              "description": "權益低於維持保證金時為 true。",
              "title": "Margin Call",
              "type": "boolean"
            }
          },
          "required": [
            "equity",
            "maintenance_margin",
            "margin_ratio_pct",
            "excess_margin",
            "margin_call"
          ],
          "title": "YuantaFuturesResponse",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "examples": [
            "1.9.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "as_of": {
          "description": "Asia/Taipei，這次回應產生的時間。",
          "title": "As Of",
          "type": "string"
        },
        "currency": {
          "const": "TWD",
          "description": "淨值、曝險、市值、損益的幣別。",
          "title": "Currency",
          "type": "string"
        },
        "usdtwd": {
          "description": "這次估價用的美元兌台幣，與第四頁同一來源。",
          "title": "Usdtwd",
          "type": "number"
        },
        "usdtwd_source": {
          "default": "live",
          "description": "1.4.0 新增。live＝即時；cached＝本程序最近一次成功值（3 天內）；last_known＝NAV_Snapshots 最後一筆即時匯率；fallback＝預設 32.5（美股市值可能失真）。",
          "enum": [
            "live",
            "cached",
            "last_known",
            "fallback"
          ],
          "title": "Usdtwd Source",
          "type": "string"
        },
        "warnings": {
          "description": "1.4.0 新增。估價警告，例如匯率不是即時值。1.6.0 起，缺 Delta 時也會說明合計不完整。",
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "exposure_complete": {
          "default": true,
          "description": "1.6.0 新增。false 表示有部位缺 Delta，exposure、leverage、beta 與 beta_leverage 只加總已知部位。",
          "title": "Exposure Complete",
          "type": "boolean"
        },
        "exposure_scope": {
          "default": "complete",
          "description": "1.6.0 新增。partial＝已知部位的部分合計，不是確認後的全部曝險。",
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Exposure Scope",
          "type": "string"
        },
        "unknown_delta_symbols": {
          "description": "1.6.0 新增。缺少 Delta、因此沒有計入名目曝險的代號。",
          "items": {
            "type": "string"
          },
          "title": "Unknown Delta Symbols",
          "type": "array"
        },
        "net_value": {
          "description": "總帳戶淨值，台幣。第四頁 metrics.nav。",
          "title": "Net Value",
          "type": "number"
        },
        "exposure": {
